<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050811">

    <!-- Zero-Copy Direct Rendering Surface -->
    <SurfaceView
        android:id="@+id/projection_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Wireless Connection Hub & First-Boot Guide Overlay -->
    <ScrollView
        android:id="@+id/guide_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="#E60A0E1A">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="24dp">

            <!-- Title & Subtitle -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="UNIPLAY WIRELESS"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Universal Dual Receiver for Apple CarPlay &amp; Android Auto"
                android:textColor="#88A0C0"
                android:textSize="13sp" />

            <!-- Live Network & Device Badges -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp">

                <TextView
                    android:id="@+id/badge_wifi_ip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#1E2A44"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:text="Wi-Fi IP: Detecting..."
                    android:textColor="#4E9FFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/badge_bluetooth"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:background="#1E2A44"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:text="Bluetooth: Uniplay-Wireless"
                    android:textColor="#50E3C2"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Guide Cards Side-by-Side -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="20dp"
                android:gravity="center">

                <!-- Apple CarPlay Guide Card -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="10dp"
                    android:orientation="vertical"
                    android:background="#141E33"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🍏 Apple CarPlay (Wireless)"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="1. Connect iPhone to car's 5GHz Wi-Fi or Hotspot."
                        android:textColor="#C0D0E8"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="2. Ensure Bluetooth &amp; Wi-Fi are turned ON."
                        android:textColor="#C0D0E8"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="3. On iPhone: Settings ➔ General ➔ CarPlay ➔ Select Uniplay."
                        android:textColor="#C0D0E8"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="4. Screen will mirror automatically."
                        android:textColor="#4E9FFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Android Auto Guide Card -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical"
                    android:background="#141E33"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🤖 Android Auto (Wireless)"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="1. Connect Android phone to car's Wi-Fi network."
                        android:textColor="#C0D0E8"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="2. Pair phone with car's Bluetooth."
                        android:textColor="#C0D0E8"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="3. Open Android Auto app or accept connection prompt."
                        android:textColor="#C0D0E8"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="4. High-speed AAP stream begins over Port 5000."
                        android:textColor="#50E3C2"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Bottom Live Connection Status -->
            <TextView
                android:id="@+id/text_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Waiting for incoming phone connection on port 5000..."
                android:textAlignment="center"
                android:textColor="#00FF9D"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Optimization tip -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Tip: For smooth 60fps streaming without stutter, ensure head unit hotspot is on 5GHz band."
                android:textColor="#556A88"
                android:textSize="11sp" />

        </LinearLayout>
    </ScrollView>

</FrameLayout>
